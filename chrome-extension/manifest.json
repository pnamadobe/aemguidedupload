{
  "manifest_version": 3,
  "name": "AEM Guided Upload — Drag-and-Drop Guardrail",
  "version": "0.3.2",
  "description": "Routes AEM Assets View drag-and-drop uploads into the Guided Upload modal to enforce folder metadata and naming rules.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AEM Guided Upload Guardrail — Options",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://experience.adobe.com/*",
    "https://experience-stage.adobe.com/*",
    "https://*.adobeaemcloud.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://experience.adobe.com/*",
        "https://experience-stage.adobe.com/*",
        "https://*.adobeaemcloud.com/*"
      ],
      "js": [
        "src/folder-reader.js",
        "src/modal-bridge.js",
        "src/dnd-guard.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://experience.adobe.com/*",
        "https://experience-stage.adobe.com/*",
        "https://*.adobeaemcloud.com/*"
      ],
      "js": [
        "src/settings-sync.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}
