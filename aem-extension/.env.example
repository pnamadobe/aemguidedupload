# Adobe I/O Runtime credentials (populated by `aio app use`)
# AIO_runtime_auth=
# AIO_runtime_namespace=

# Optional fallback AEM author URL + credentials when not supplied by the Assets View host
# (In normal operation, the extension uses the signed-in user's IMS token and host from Assets View)
AEM_AUTHOR_URL=https://author-p59602-e520244.adobeaemcloud.com
# Base64-encoded AEM Service Credential JSON (optional fallback for local testing)
AEM_SC_JSON=
# Or AEM Developer Token fallback
AEM_DEV_TOKEN=
